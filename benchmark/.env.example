# Copy to benchmark/.env to change defaults, or set these in the environment for one run.

# App host size. Defaults: local 2 vCPU / 4g, remote 1 vCPU / 1g.
# APP_CPUS=2
# APP_MEM=4g
# Playwright server size (mode `remote` only).
SERVER_CPUS=2
SERVER_MEM=4g

# Pages rendered at once, across all builds (local: STORYSHELF_CAPTURE_CONCURRENCY, remote: sessions).
PAGES=4
# Builds uploaded and captured at the same time.
BUILDS=3
# Host port of the app.
APP_PORT=3000
# Built Storybook to upload, relative to the repository root.
STORYBOOK_DIR=../design-system/storybook-static
