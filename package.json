{
  "name": "aiven-storyshelf",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "StoryShelf self-hosted visual testing server.",
  "scripts": {
    "start": "node --experimental-transform-types server/index.ts",
    "dev": "node --experimental-transform-types --watch server/index.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@hono/node-server": "^1.17.0",
    "postgres": "^3.4.9",
    "@storyshelf/core": "0.6.1",
    "@storyshelf/app": "0.6.1",
    "@storyshelf/auth": "0.6.1",
    "@storyshelf/observability": "0.6.1",
    "@storyshelf/db-postgres": "0.6.1",
    "@storyshelf/runner-playwright": "0.6.1",
    "@storyshelf/git-github": "0.6.1",
    "@storyshelf/storage-local": "0.6.1",
    "@storyshelf/notify-chat": "0.6.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
